# Isi .env di server dengan nilai rahasia yang kuat; jangan commit file .env.
# Gunakan karakter alfanumerik untuk password database agar aman di dalam DSN.

# Password user `app` di MariaDB (harus sama dengan password user `app` yang dibuat di MariaDB).
DB_PASSWORD=ganti_dengan_password_db_acak

# Opsional. Nama jaringan Docker tempat container MariaDB berada (bawaan: db-net).
# Cek dengan: docker inspect mariadb --format '{{range $n,$c := .NetworkSettings.Networks}}{{println $n}}{{end}}'
# DB_NETWORK=db-net

# Opsional. Nama container/host MariaDB di jaringan itu (bawaan: mariadb).
# DB_HOST=mariadb

# Wajib, minimal 32 karakter acak. Contoh membuat: openssl rand -hex 32
# Mengganti nilai ini membuat semua pengguna harus login ulang.
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Opsional. Umur maksimal sesi login dalam jam (bawaan 12) dan batas tidak aktif dalam menit (bawaan 240).
# SESI_JAM=12
# SESI_IDLE_MENIT=240

# Opsional. Daftar CIDR proxy yang dipercaya untuk menentukan IP asli pengguna (nginx, cloudflared).
# Bawaan: jaringan privat 10/8, 172.16/12, 192.168/16, dan loopback.
# TRUSTED_PROXIES=172.16.0.0/12

# Opsional, hanya untuk pengujian lokal lewat http (bukan https). Di server biarkan kosong.
# COOKIE_SECURE=false

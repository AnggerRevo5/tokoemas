# Isi .env di server dengan nilai rahasia yang kuat; jangan commit file .env.
# Gunakan karakter alfanumerik untuk password database agar aman di dalam DSN.
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_acak
DB_PASSWORD=ganti_dengan_password_db_acak
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
